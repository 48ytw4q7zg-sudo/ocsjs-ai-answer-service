# ============================================
# AI 答题服务配置文件模板
# ============================================
# 复制此文件为 .env 并修改配置
# 优先使用 ccswitch 代理（自动读取 ~/.claude/settings.json）
# 如果未检测到 ccswitch，则使用下面的 .env 配置作为回退
# ============================================

# 服务设置（默认仅回环；Docker/LAN 需显式 HOST=0.0.0.0）
HOST=127.0.0.1
PORT=5000
DEBUG=False

# 回退 API 配置（仅当 ccswitch 不可用时使用）
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro

# AI 客户端参数
API_TIMEOUT=30.0
API_MAX_RETRIES=2
# anthropic | openai_chat | openai_responses
# AI_API_PROTOCOL=anthropic

# 响应参数
MAX_TOKENS=500
TEMPERATURE=0.7
# 简答题的输出上限至少取该值（避免长句被截断后整题失败）
SHORT_ANSWER_MAX_TOKENS=1024
# 单选/多选/判断/填空的温度上限（需要唯一解，越低越稳定）
OBJECTIVE_TEMPERATURE_CAP=0.3

# 缓存设置
ENABLE_CACHE=True
CACHE_EXPIRATION=86400
# 可选：把答案缓存同时写入 SQLite 文件（只存题目哈希与答案，不存题目原文），重启后仍可命中
# CACHE_PERSIST_FILE=data/answer-cache.sqlite3

# 输入限制
MAX_QUESTION_LENGTH=2000
# 选项个数上限：按 A./B. 标号计数（长选项折行不重复计），没有标号时按行计
MAX_OPTIONS=64
MAX_OPTIONS_LENGTH=8000
MAX_REQUEST_BYTES=262144

# Access Token（局域网 / Docker / 反向代理或内网穿透部署必须设置；客户端推荐用 X-Access-Token 请求头传递，
# 令牌只能用英文字母、数字和符号）
# 未设置时只允许本机直连调用：来源与 Host 都必须是本机地址，带代理转发头或被其它网站嵌入触发的请求会被拒绝。
# ACCESS_TOKEN=your_access_token_here
# 确需免令牌对外开放时才改为 true（高风险：任何能访问端口的人都能消耗模型额度）
# ALLOW_REMOTE_WITHOUT_TOKEN=false
# 兼容旧写法：允许把令牌放在网址（?token=）或请求体里；OCS 配置改用 headers 后可设为 false
# ALLOW_LEGACY_TOKEN_LOCATIONS=true

# 每个客户端每分钟最多触发的 AI 调用次数（缓存命中不计，0 表示不限）
RATE_LIMIT_PER_MINUTE=60

# 是否读取 ~/.claude/settings.json（ccswitch）；便携版始终不读
# CCSWITCH_ENABLED=true

# 日志级别 (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO
