# ============================================
# AI 答题服务配置文件模板
# ============================================
# 复制此文件为 .env 并修改配置
# 优先使用 ccswitch 代理（自动读取 ~/.claude/settings.json）
# 如果未检测到 ccswitch，则使用下面的 .env 配置作为回退
# ============================================

# 服务设置
HOST=0.0.0.0
PORT=5000
DEBUG=True

# 回退 API 配置（仅当 ccswitch 不可用时使用）
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro

# AI 客户端参数
API_TIMEOUT=30.0
API_MAX_RETRIES=2

# 响应参数
MAX_TOKENS=500
TEMPERATURE=0.7

# 缓存设置
ENABLE_CACHE=True
CACHE_EXPIRATION=86400

# 输入限制
MAX_QUESTION_LENGTH=2000

# Access Token 配置 (可选，设置后 API 需要令牌验证)
# ACCESS_TOKEN=your_access_token_here

# 日志级别 (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO
