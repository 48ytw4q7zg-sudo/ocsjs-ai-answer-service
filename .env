# ============================================
# AI 答题服务配置文件
# ============================================
# 优先使用 ccswitch 代理（自动读取 ~/.claude/settings.json）
# 如果未检测到 ccswitch，则使用下面的 .env 配置作为回退
# ============================================

# 服务设置
HOST=0.0.0.0
PORT=5000
DEBUG=True

# 回退 API 配置（仅当 ccswitch 不可用时使用）
# 注意：如果 ccswitch 正在运行，以下配置会被忽略，
# 服务会自动通过 ccswitch 代理 (http://127.0.0.1:15721) 调用 API
ANTHROPIC_API_KEY=PROXY_MANAGED
ANTHROPIC_BASE_URL=http://127.0.0.1:15721
ANTHROPIC_MODEL=deepseek-v4-pro

# 响应参数
MAX_TOKENS=500
TEMPERATURE=0.7

# 缓存设置
ENABLE_CACHE=True
CACHE_EXPIRATION=86400

# 安全设置 (可选)
# ACCESS_TOKEN=your_access_token_here
